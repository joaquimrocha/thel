{
  "name": "thel",
  "private": true,
  "version": "0.8.0",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "node --test --test-concurrency=1 'tests-e2e/*.test.ts'",
    "screenshots": "node scripts/screenshots.ts",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "build:container": "bin=docker; docker info >/dev/null 2>&1 || bin=podman; $bin build -t thel-build . && id=$($bin create thel-build) && $bin cp \"$id:/app/src-tauri/target/release/bundle\" ./bundle && $bin rm \"$id\""
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-context-menu": "^2.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tauri-apps/api": "~2.11.0",
    "@tauri-apps/plugin-clipboard-manager": "~2.3.2",
    "@tauri-apps/plugin-dialog": "~2.7.1",
    "@tauri-apps/plugin-store": "~2.4.3",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-unicode11": "^0.8.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/addon-webgl": "^0.18.0",
    "@xterm/xterm": "^5.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zustand": "^5.0.16"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-rj75-hqrm-r3gf"
      ]
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tauri-apps/cli": "^2.12.4",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.1",
    "monocart-coverage-reports": "^2.13.2",
    "postcss": "^8.5.31",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.9.3",
    "vite": "^6.4.5",
    "vitest": "^5.0.5"
  }
}
